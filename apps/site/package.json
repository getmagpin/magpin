{
  "name": "@magpin/site",
  "private": true,
  "version": "0.1.0",
  "description": "Magpin's one-page website.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/prerender.tsx --outDir node_modules/.cache/prerender --emptyOutDir && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@magpin/core": "workspace:*",
    "@magpin/ui": "workspace:*",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "preact-render-to-string": "6.8.2",
    "typescript": "~5.9.3",
    "vite": "^8.3.6"
  }
}
